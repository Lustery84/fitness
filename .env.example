# Gemini Vision API (Google AI Studio - miễn phí theo quota)
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite

# Tùy chọn: Ollama Local Vision (miễn phí, không giới hạn quota)
OLLAMA_BASE_URL=
OLLAMA_VISION_MODEL=llama3.2-vision

# Supabase (dự án "sinbad" — lấy từ Settings -> Data API & API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (Tương thích cả biến legacy nếu có)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
